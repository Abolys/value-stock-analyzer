# Copy to .env and fill in. .env is git-ignored; never commit it.

# LLM lenses (Moat, Devil's Advocate, 6-K check). Optional API key, billed via the Claude
# Console. Leave it blank to run them through the Claude Code CLI on your Claude subscription.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# auto (API with a key, else Claude Code) | api | claude_code | none
LLM_BACKEND=auto
# Path to the claude binary if it is not on PATH or in the VS Code extension folder
CLAUDE_CODE_CLI=

# Required by the SEC for EDGAR requests: your name and contact email
SEC_USER_AGENT="Your Name your@email.com"

# Optional: email alerts (Phase 6). Leave blank to keep alerts in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Sender address; defaults to SMTP_USER
ALERT_EMAIL_FROM=
