# Copy to .env and fill in. .env is git-ignored; never commit it.

# Anthropic API (billed via the Claude Console, separate from any Claude subscription)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Required by the SEC for EDGAR requests: your name and contact email
SEC_USER_AGENT="Your Name your@email.com"

# Optional: Financial Modeling Prep (longer fundamental history, fallback provider)
FMP_API_KEY=

# Optional: email alerts (Phase 6). Leave blank to keep alerts in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
