# Copy to .env and fill in. .env is git-ignored; never commit it.

# LLM lenses (Moat, Devil's Advocate, 6-K check). Order with LLM_BACKEND=auto: the free tier
# (FREE_LLM_API_KEY) first, a failed free-tier call falls back to the billed Anthropic API
# (ANTHROPIC_API_KEY), else the Claude Code CLI on your Claude subscription.
# Free tier: any OpenAI-compatible chat-completions endpoint. Groq's free dev tier by default
# (create a key at https://console.groq.com/keys, no card needed).
FREE_LLM_BASE_URL=https://api.groq.com/openai/v1
FREE_LLM_API_KEY=
FREE_LLM_MODEL=openai/gpt-oss-120b
# Optional API key, billed via the Claude Console.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# auto (free tier, then API, else Claude Code) | api | claude_code | free | none
LLM_BACKEND=auto
# Path to the claude binary if it is not on PATH or in the VS Code extension folder
CLAUDE_CODE_CLI=

# Required by the SEC for EDGAR requests: your name and contact email
SEC_USER_AGENT="Your Name your@email.com"

# Sharing the app with a link (scripts/share.py). Local use needs neither; through the link, the owner
# password gives full access and the viewer password read-only access (no edits, no LLM calls).
APP_OWNER_PASSWORD=
APP_VIEWER_PASSWORD=

# Optional: email alerts (Phase 6). Leave blank to keep alerts in-app only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
# Sender address; defaults to SMTP_USER
ALERT_EMAIL_FROM=
