# Secrets — never commit
.env
.env.*
!.env.example

# Local data, caches and databases.
# The live databases are never committed: Streamlit Cloud cannot write to
# git-tracked files. Instead a read-only snapshot lives in baseline/ (refresh it
# with scripts/update_baseline.py); on start the app copies it into place when
# a live file is missing (storage/baseline.py). Data flows local -> Cloud only.
# Trade-off: binary blobs grow the repo history.
*.db
!baseline/*.db
*.sqlite
*.sqlite3
.cache/
data/cache/*
data/universe/raw/
data/universe/refresh_status.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# Exports and OS files
reports/output/
.DS_Store
Thumbs.db

# Project archives
*.zip

# SQLite side files for the committed databases (journal/WAL/SHM never committed)
*.db-journal
*.db-wal
*.db-shm
*.baseline-sha

# Streamlit local secrets
.streamlit/secrets.toml

# Tool caches
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Screen run logs
storage/logs/
