# Secrets — never commit
.env
.env.*
!.env.example

# Local data, caches and databases.
# Baseline for the deploy: storage/runs.db and the live caches are committed so
# every Streamlit Cloud deploy starts with the latest screens, portfolio and
# warm caches (data flows local -> Cloud; the Cloud app can read but not push).
# Trade-off: binary blobs grow the repo history.
*.db
!storage/runs.db
*.sqlite
*.sqlite3
.cache/
data/cache/*
!data/cache/cache.db
!data/cache/llm_cache.db
data/universe/raw/
data/universe/refresh_status.json

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
env/

# Exports and OS files
reports/output/
.DS_Store
Thumbs.db

# Project archives
*.zip

# SQLite side files for the committed databases (journal/WAL/SHM never committed)
*.db-journal
*.db-wal
*.db-shm

# Streamlit local secrets
.streamlit/secrets.toml

# Tool caches
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/

# Screen run logs
storage/logs/
